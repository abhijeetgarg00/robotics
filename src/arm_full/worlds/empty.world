<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="empty">

    <!-- Provide ROS init & clock inside gz sim -->
   <!-- <plugin filename="libgz_ros_init-system.so"
            name="ros_gz_sim::systems::RosInit"/>
    <plugin filename="libgz_ros_clock-system.so"
            name="ros_gz_sim::systems::RosClock"/>-->

    <!-- Simple sun light (no Fuel) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.5 -1.0</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </light>

    <!-- Ground plane made from a primitive (no Fuel) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
